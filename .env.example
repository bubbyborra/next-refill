# Agora Console > your project
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Murf API dashboard (Falcon voices)
MURF_API_KEY=
# Sarvam dashboard (speech-to-text for Indian languages)
SARVAM_API_KEY=
# Anthropic API key (the model behind the agent)
ANTHROPIC_API_KEY=
# Claude model for the call: claude-sonnet-5-5 or claude-haiku-5-5 (reasoning is turned off for both)
WD_MODEL=
# Any long random string. Agora sends it to /api/llm so only your agent can call it.
LLM_ROUTE_KEY=
# Public https URL of this app (your Vercel URL, or a tunnel URL when running locally)
PUBLIC_BASE_URL=
# Optional: Upstash Redis (Vercel > Storage). Without it, call state lives in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
